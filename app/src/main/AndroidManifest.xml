<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FinPulseApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-link intent-filter for finpulse:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="finpulse"
                    android:host="quick-add" />
                <data
                    android:scheme="finpulse"
                    android:host="review-inbox" />
                <data
                    android:scheme="finpulse"
                    android:host="accounts" />
                <data
                    android:scheme="finpulse"
                    android:host="budgets" />
                <data
                    android:scheme="finpulse"
                    android:host="analytics" />
                <data
                    android:scheme="finpulse"
                    android:host="calendar" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Widget Configuration Activity -->
        <activity
            android:name=".presentation.widget.WidgetConfigurationActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Current Balance Widget -->
        <receiver
            android:name=".presentation.widget.CurrentBalanceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_balance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.finpulse.app.action.TOGGLE_WIDGET_PRIVACY" />
                <action android:name="com.finpulse.app.action.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>

        <!-- Monthly Spending Widget -->
        <receiver
            android:name=".presentation.widget.MonthlySpendingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_spending">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.finpulse.app.action.TOGGLE_WIDGET_PRIVACY" />
                <action android:name="com.finpulse.app.action.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spending_info" />
        </receiver>

        <!-- Budget Remaining Widget -->
        <receiver
            android:name=".presentation.widget.BudgetRemainingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_budget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.finpulse.app.action.TOGGLE_WIDGET_PRIVACY" />
                <action android:name="com.finpulse.app.action.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_info" />
        </receiver>

        <!-- Upcoming Bills Widget -->
        <receiver
            android:name=".presentation.widget.UpcomingBillsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_bills">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.finpulse.app.action.TOGGLE_WIDGET_PRIVACY" />
                <action android:name="com.finpulse.app.action.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bills_info" />
        </receiver>

        <!-- Quick Add Widget -->
        <receiver
            android:name=".presentation.widget.QuickAddWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_quick_add">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <!-- FinPulse Dashboard Multi-Widget -->
        <receiver
            android:name=".presentation.widget.FinPulseDashboardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name_dashboard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.finpulse.app.action.TOGGLE_WIDGET_PRIVACY" />
                <action android:name="com.finpulse.app.action.REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard_info" />
        </receiver>

        <!-- File Provider for Backup & CSV Sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
