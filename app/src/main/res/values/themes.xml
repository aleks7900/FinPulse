<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme shown before Compose draws. Matches the Compose surface so there is no
         flash between launch and first frame; follows system light/dark via values-night. -->
    <style name="Theme.FinPulse" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/finpulse_window_background</item>
        <item name="android:colorPrimary">@color/finpulse_primary</item>
        <item name="android:colorAccent">@color/finpulse_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
