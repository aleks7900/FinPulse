<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include core database for offline financial history restore -->
        <include domain="database" path="finpulse.db" />
        <include domain="database" path="finpulse.db-wal" />
        <include domain="database" path="finpulse.db-shm" />
        <!-- Include non-sensitive preferences (theme, currency) -->
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
